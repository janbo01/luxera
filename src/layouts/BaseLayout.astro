---
import { ClientRouter } from 'astro:transitions'
import AppShell from '../components/layout/AppShell'
import Header from '../components/layout/Header'
import Footer from '../components/layout/Footer'
import { fetchThemeStyleTag, fetchSocialSettings, fetchSettingsScript } from '../lib/ssr'
import HydrateReader from '../components/shared/HydrateReader.astro'
import '../index.css'

interface Props {
  title: string
  description?: string
  canonical?: string
  ogImage?: string
  ogType?: string
  jsonLd?: string
  lcpPreload?: string
  noIndex?: boolean
  /** Checkout: hide the store navigation so the page has one job. */
  focus?: boolean
  /** id of an element the page renders at the end of its first screen; the first paint
   *  waits for its markup too (see the rel="expect" links below). */
  foldId?: string
}

const {
  title,
  description = 'لوکسرا — فروشگاه اینترنتی جواهرات فانتزی دست‌ساز. گردنبند، انگشتر، دستبند و گوشواره با روکش ماندگار، بدون نیکل، با ارسال یک‌روزه در تهران.',
  canonical,
  ogImage = 'https://luxera.ir/og-image.webp',
  ogType = 'website',
  jsonLd,
  lcpPreload,
  noIndex = false,
  focus = false,
  foldId,
} = Astro.props

const [theme, socialSettings, settingsScript] = await Promise.all([
  fetchThemeStyleTag(),
  fetchSocialSettings(),
  fetchSettingsScript(),
])

// The theme <style> tag's content is per-request (store settings), so it isn't covered
// by astro.config.mjs's auto-hashed CSP — register its hash for this response.
// settingsScript is an inert JSON island (see jsonIsland() in ssr.ts) — CSP doesn't
// apply to it at all, so no hash is needed there.
if (theme.hash) Astro.csp?.insertStyleHash(theme.hash)

const SITE_URL = 'https://luxera.ir'
const rawCanonical = canonical ? `${SITE_URL}${canonical}` : `${SITE_URL}${Astro.url.pathname}`
// Always normalise to the no-trailing-slash form (incl. the home page) so the
// canonical matches the URL crawlers actually request (https://luxera.ir, not
// https://luxera.ir/). This collapses the "/" vs "" duplicate into one canonical.
const canonicalUrl = rawCanonical.replace(/\/+$/, '') || SITE_URL
---

<!doctype html>
<html lang="fa" dir="rtl" data-focus={focus ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="mask-icon" href="/icon-mono.svg" color="#1A1412" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow'} />
    <meta name="author" content="لوکسرا" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="author" href="https://luxera.ir/about" />

    <!-- Preconnect to external origins for faster image CDN and API loading -->
    <link rel="preconnect" href="https://image.luxera.ir" />
    <link rel="dns-prefetch" href="https://image.luxera.ir" />
    <link rel="preconnect" href="https://api.luxera.ir" crossorigin />
    <link rel="dns-prefetch" href="https://api.luxera.ir" />

    <!-- Preload every face the first screen of any page draws (~20 KB each). The faces
         are font-display: optional (index.css), so a face that isn't ready for the first
         paint is skipped for that page view rather than swapped in later — the swap was
         the store's biggest layout shift. Yekan Bakh 400 body, 500 labels/prices,
         700 (also serves semibold) buttons; Morabba 700 headings, 400 their <em>.
         Light (300) only styles form fields, so it isn't preloaded.
         URLs must match the @font-face src in index.css exactly. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/yekanbakh-Regular.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/yekanbakh-Medium.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/yekanbakh-Bold.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Morabba-Bold.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/Morabba-Regular.woff2" crossorigin />

    <!-- Hold the first paint until the header's markup is parsed (and, on pages that
         pass foldId, their first screen). On a slow connection the browser otherwise
         paints HTML while it is still arriving — the logo, then the buttons, trickle in
         and each late piece moves what is already on screen. Kept to the top of the page:
         waiting for all of <main> cost the home page ~3s of first paint on a slow phone.
         Chrome 124+; other browsers ignore it. Images and fonts are not waited for. -->
    <link rel="expect" href="#lx-header-end" blocking="render" />
    {foldId && <link rel="expect" href={`#${foldId}`} blocking="render" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Preload LCP image (injected per-page) -->
    {lcpPreload && <Fragment set:html={lcpPreload} />}

    <!-- Theme CSS (injected from store API) -->
    {theme.html && <Fragment set:html={theme.html} />}

    <!-- Settings (injected from store API, so client hooks don't re-fetch on mount) -->
    {settingsScript && <Fragment set:html={settingsScript} />}

    <!-- JSON-LD structured data (injected per-page) -->
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}

    <!-- Reads every page's JSON-island hydration data into window globals — once, here,
         not per-page: see HydrateReader.astro for why. -->
    <HydrateReader />

    <!-- Astro ClientRouter for SPA-like navigation -->
    <ClientRouter />
  </head>
  <body>
    <!--
      AppShell: CartDrawer, SearchOverlay, LoginModal, BottomNav, ScrollToTop.
      transition:persist keeps it mounted across navigations so Zustand stores
      and subscriptions survive page transitions without teardown/recreate.
    -->
    <AppShell client:only="react" transition:persist="app-shell" />

    <!-- Header persists independently so it can update active state via usePathname -->
    <Header client:load transition:persist="header" />
    <div id="lx-header-end" hidden></div>

    <!-- Reserve a viewport of height so client:only views (e.g. ProductPage) don't
         leave <main> empty at first paint — which would place the footer right under
         the header and then shove it down a full page when React renders, causing a
         large layout shift. With this reserve the footer stays below the fold until
         content fills in, so its push-down happens off-screen and doesn't count toward CLS. -->
    <main class="min-h-screen">
      <slot />
    </main>

    <!-- Footer: initialSettings pre-populates social links from SSR to avoid CLS on hydration -->
    <Footer client:idle transition:persist="footer" initialSettings={socialSettings} />
  </body>
</html>
