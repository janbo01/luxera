---
import BaseLayout from '../layouts/BaseLayout.astro'
import HomePage from '../views/HomePage'
import Feature from '../components/home/Feature'
import BlogCarousel from '../components/home/BlogCarousel'
import { fetchHomeData, fetchHomeListsData, fetchFooterData, buildFooterScript } from '../lib/ssr'

const [{ lcpPreload, initialScript, banners }, homeLists, footerData] = await Promise.all([
  fetchHomeData(),
  fetchHomeListsData(),
  fetchFooterData(),
])

const footerScript = buildFooterScript(footerData)

const BASE_TITLE = 'Luxera · لوکسرا'

const homeJsonLd = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'لوکسرا',
    url: 'https://luxera.ir',
    potentialAction: {
      '@type': 'SearchAction',
      target: { '@type': 'EntryPoint', urlTemplate: 'https://luxera.ir/search?q={search_term_string}' },
      'query-input': 'required name=search_term_string',
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'لوکسرا',
    url: 'https://luxera.ir',
    logo: 'https://luxera.ir/icon-512.png',
    description: 'فروشگاه اینترنتی جواهرات فانتزی دست‌ساز — گردنبند، انگشتر، دستبند و گوشواره با روکش ماندگار، بدون نیکل.',
    contactPoint: {
      '@type': 'ContactPoint',
      telephone: '+989128494308',
      contactType: 'customer service',
      availableLanguage: 'Persian',
    },
    sameAs: ['https://instagram.com/luxera.ir'],
  },
])
---

<BaseLayout
  title={`فروشگاه جواهرات فانتزی دست‌ساز | ${BASE_TITLE}`}
  description="لوکسرا — فروشگاه اینترنتی جواهرات فانتزی دست‌ساز. گردنبند، انگشتر، دستبند و گوشواره با روکش ماندگار، بدون نیکل، با ارسال یک‌روزه در تهران."
  canonical="/"
  lcpPreload={lcpPreload}
  jsonLd={homeJsonLd}
  foldId="lx-fold"
>
  <Fragment set:html={initialScript + footerScript} />
  <HomePage client:load banners={banners} lists={homeLists.data} />
  <Feature />
  <BlogCarousel client:visible initial={homeLists.data?.blog} />
</BaseLayout>
