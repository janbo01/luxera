PUBLIC_USER_API=https://api.luxera.ir/users
PUBLIC_PRODUCT_API=https://api.luxera.ir/products
PUBLIC_ORDER_API=https://api.luxera.ir/orders
PUBLIC_PAYMENT_API=https://api.luxera.ir/payments
PUBLIC_STORE_API=https://api.luxera.ir
# Self-hosted imgproxy (resizes ArvanCloud storage images). Empty = serve originals.
# Requires the img.luxera.ir DNS record + page rule in the ArvanCloud panel
# (see docs/image-cdn-setup.md) — do not deploy with this set until DNS resolves.
PUBLIC_IMAGE_CDN=https://img.luxera.ir
